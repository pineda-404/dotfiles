# Obsidian Minimal Theme for Ghostty
# Based on Kepano's Minimal theme for Obsidian
# Colors extracted from theme.css

# Background and foreground
# background = #0d0d0d
# foreground = #d2d2d2
background = #151515
foreground = #f0efec

# Cursor
# cursor-color = #d2d2d2
cursor-color = #f0efec

# Selection
# selection-background = #404040
# selection-foreground = #d2d2d2
selection-background = #2d2d2d
selection-foreground = #f0efec

# ANSI Colors (0-7: normal, 8-15: bright)
# 0: Black
# palette = 0=#0d0d0d
# palette = 8=#595959

palette = 0=#151515
palette = 8=#4a4a4a

# 1: Red
palette = 1=#d04255
palette = 9=#d04255

# 2: Green
palette = 2=#a8c373
palette = 10=#a8c373

# 3: Yellow
palette = 3=#e5b567
palette = 11=#e5b567

# 4: Blue
palette = 4=#6c99bb
palette = 12=#6c99bb

# 5: Magenta/Purple (for keywords)
palette = 5=#b05279
palette = 13=#9e86c8

# 6: Cyan (harmonized to lila)
palette = 6=#9e86c8
palette = 14=#73bbb2

# 7: White
palette = 7=#d2d2d2
palette = 15=#ffffff
